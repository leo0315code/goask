# ===== GoAsk 配置模板：复制为 .env 后按需修改 =====

# 运行环境：dev / release（release 启用 Gin 生产模式）
APP_ENV=dev

# HTTP 监听端口
PORT=8080

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=goask
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# JWT 密钥：上线必须替换为 >=32 位强随机值（缺失或过短时拒绝启动）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRE=72h
BCRYPT_COST=12

# CORS 白名单（逗号分隔，* 表示放行所有来源；生产必须收敛）
CORS_ORIGINS=*

# 部署在 Nginx / SLB 后时配置代理网段（逗号分隔 CIDR），否则留空
TRUSTED_PROXIES=

# 限流（次/分钟/IP）
RATE_LIMIT_GLOBAL_RPM=120
RATE_LIMIT_AUTH_RPM=10

# 启动时自动执行数据库迁移
MIGRATE_ON_START=true

# 首次启动种子管理员账号（两项都设置才生效；上线后应移除）
#SEED_ADMIN_USERNAME=admin
#SEED_ADMIN_PASSWORD=admin123456
